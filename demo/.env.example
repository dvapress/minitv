# LeapDrama demo configuration. Copy to .env on the server and fill secrets there.
# Never commit .env. This template intentionally has empty secrets.

# Public origin rei-deploy will point at this service. DNS/TLS are not handled here.
LEAPDRAMA_PUBLIC_BASE_URL=https://leapdrama-demo.rei.autos

# Supported on aiexplorer.asia: listen on loopback only. A separate Cloudflare
# Tunnel (not cloudflared-leapai-v2) publishes leapdrama-demo.rei.autos.
# 18080 was free; do not use 8787 or 20242.
LEAPDRAMA_BIND=127.0.0.1
LEAPDRAMA_PORT=18080

# Optional Compose publish address, only if the process user can access docker.sock.
# harleyw cannot. Leave these unused on that host.
LEAPDRAMA_PUBLISH_IP=127.0.0.1
LEAPDRAMA_PUBLISH_PORT=18080

# Directory of series folders, mounted read-only at /media in Compose.
# Example after transfer: /srv/leapdrama/incoming
# The Mac source path is NOT assumed to exist on the server.
LEAPDRAMA_MEDIA_HOST_PATH=./incoming

# Bare metal only. Compose overrides this to /data (the named volume).
# LEAPDRAMA_DATA_DIR=/var/lib/leapdrama

# Leave both blank to generate /data/secret.key and /data/admin.password on first start.
# Values are never printed. Do not put a real password in this file.
LEAPDRAMA_SECRET_KEY=
LEAPDRAMA_ADMIN_EMAIL=admin@leapdrama.demo
LEAPDRAMA_ADMIN_PASSWORD=

# auto = Secure cookie only when the request is HTTPS (use X-Forwarded-Proto at the proxy).
LEAPDRAMA_COOKIE_SECURE=auto

# Flag episodes longer than this many seconds. Originals are never trimmed.
LEAPDRAMA_MAX_EPISODE_SECONDS=180

# Creator upload limit in bytes (512 MiB).
LEAPDRAMA_MAX_UPLOAD_BYTES=536870912

# Extra roots the process may read for --in-place playback. Colon-separated.
# Compose sets this to /media. Leave empty on bare metal when using the default copy mode.
LEAPDRAMA_LIBRARY_ROOTS=
